{
  "expo": {
    "name": "Collegium",
    "slug": "srm-mobile",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon1.png",
    "splash": {
      "image": "./assets/images/my-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2ED",
      "dark": {
        "image": "./assets/images/my-icon1.png",
        "backgroundColor": "#1A1E2E"
      }
    },
    "scheme": "srmmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yashtomar21.srmmobile"
    },
    "android": {
      "package": "com.yashtomar21.srmmobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/my-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F2ED",
          "dark": {
            "image": "./assets/images/my-icon1.png",
            "backgroundColor": "#1A1E2E"
          }
        }
      ],
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6c46341c-01bd-4748-866b-32d713e21dde"
      }
    }
  }
}
